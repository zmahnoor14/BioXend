/*
 * BioXend — nextflow.config
 * MIX-MB ChEMBL Submission Pipeline
 */

manifest {
    name            = 'BioXend'
    author          = 'Mahnoor Zulfiqar (EMBL)'
    description     = 'MIX-MB ChEMBL submission file generator'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '0.4.1'  // kept in sync with versions/workflow.txt by auto-version.yml
}

params {
    input            = null
    prefix           = "HMDM"
    xenobiotic_class = "xenobiotic compound"
    outdir           = "${projectDir}/results"
    strict           = false
    help             = false
    publish_dir_mode = 'copy'
}

workDir = "${launchDir}/work"

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    container = 'zmahnoor/bioxend:latest'
}

includeConfig 'conf/base.config'

includeConfig 'conf/modules.config'

workflow.onComplete = {
    def status = workflow.success ? "SUCCESS" : "FAILED"
    println "Pipeline ${status} | duration: ${workflow.duration} | exit: ${workflow.exitStatus}"
}

workflow.onError = {
    println "Pipeline error: ${workflow.errorMessage}"
}

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            container = 'zmahnoor/bioxend:latest'
        }
    }

    singularity {
        docker.enabled         = false
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            container = 'docker://zmahnoor/bioxend:latest'
        }
    }

    conda {
        docker.enabled = false
        conda.enabled  = true
        process {
            conda = "${projectDir}/envs/bioxend.yml"
        }
    }

    slurm {
        process.executor = 'slurm'
    }

    test {
        params.input  = 'https://raw.githubusercontent.com/zmahnoor14/BioXend/main/exampledata/Template_filled.ods'
        params.outdir = './results'
    }

}